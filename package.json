{
  "name": "atelier-match-interface",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "python -m backend.app",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:init": "python -m backend.app --init",
    "db:seed": "python -m backend.app --dev --seed",
    "start": "python -m backend.app --serve-ui",
    "test": "python -m unittest discover -s tests -p test_*.py -v",
    "test:e2e": "playwright test",
    "test:e2e:member2": "playwright test -c playwright.member2.config.ts",
    "test:e2e:member3": "playwright test -c playwright.member3.config.ts",
    "admin:create": "python -m backend.app --create-admin"
  },
  "dependencies": {
    "lucide-react": "0.575.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
